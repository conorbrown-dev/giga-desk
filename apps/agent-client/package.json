{
  "name": "@giga-desk/agent-client",
  "private": true,
  "type": "module",
  "exports": {
    "./agent-api": {
      "types": "./src/agent-api.ts",
      "default": "./dist/agent-api.js"
    },
    "./machine-token": {
      "types": "./src/machine-token.ts",
      "default": "./dist/machine-token.js"
    }
